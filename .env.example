# AutoCraft Environment Configuration

AUTOCRAFT_PROVIDER=gemini
# AUTOCRAFT_API_MOCK=1

# Comma-separated API keys for the dashboard (optional; empty = open access)
# AUTOCRAFT_API_KEYS=dev-key-1,dev-key-2

# Where to persist chat sessions
# AUTOCRAFT_SESSION_DIR=.autocraft/sessions

GEMINI_API_KEY=your_google_ai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2
# AUTOCRAFT_CORS_ORIGINS=*
